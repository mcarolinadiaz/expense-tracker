# Applies to the whole repository. api/ and web/ keep their own .gitignore for framework output.

# Environment files: keep only the example, which has no real values
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519

# Credential files
auth.json
credentials.json
service-account*.json
.htpasswd

# Database files and dumps, which can hold real user data
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# Logs and backups, which can hold tokens or personal data
*.log
*.bak

# Local Claude Code settings
.claude/settings.local.json
